# apps/web owns validation for web coordinator environment values.
# Keep this template limited to safe local defaults and placeholders.

# Current safe defaults
APP_ENV=local
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Auth0 authentication placeholders
APP_BASE_URL=<auth0-app-base-url-placeholder>
AUTH0_DOMAIN=<auth0-domain-placeholder>
AUTH0_CLIENT_ID=<auth0-client-id-placeholder>
AUTH0_CLIENT_SECRET=<auth0-client-secret-placeholder>
AUTH0_SECRET=<auth0-session-secret-placeholder>

# Server-side database placeholder.
# For the current MVP this is the Supabase Postgres connection string; do not add
# browser-visible Supabase keys unless a future client integration explicitly requires them.
DATABASE_URL=<postgres-database-url-placeholder>

# Server-side GitHub webhook placeholder
GITHUB_WEBHOOK_SECRET=<github-webhook-secret-placeholder>

# Server-side GitHub App write placeholders
GITHUB_APP_ID=<github-app-id-placeholder>
GITHUB_APP_PRIVATE_KEY=<github-app-private-key-placeholder>

# Server-side Linear OAuth credential sealing placeholders.
# Use a base64url or hex encoded 32-byte key in real environments.
LINEAR_OAUTH_TOKEN_ENCRYPTION_KEY=<base64url-32-byte-key-placeholder>
LINEAR_OAUTH_TOKEN_ENCRYPTION_KEY_ID=<linear-oauth-key-id-placeholder>

# Deferred groups
# Linear issue-sync settings will be added with package-level schema validation in later tasks.
# Do not add real secrets or service credentials to this example file.
