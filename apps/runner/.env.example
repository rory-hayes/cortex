# apps/runner owns validation for local runner environment values.
# Keep this template limited to safe local defaults and placeholders.

# Current safe defaults
RUNNER_MODE=local
COORDINATOR_BASE_URL=http://localhost:3000
RUNNER_MAX_CONCURRENCY=1
RUNNER_WORKTREE_ROOT=.codex-runner-worktrees
LOG_LEVEL=info

# Deferred local-only values
# Pairing, runner auth, local gh auth, and Codex CLI auth stay local and will be
# documented with package-level schema validation in later tasks.
# Do not add real tokens, pairing codes, private keys, passwords, or credentials
# to this example file.
